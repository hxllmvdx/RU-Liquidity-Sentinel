POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ru_liquidity_sentinel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgres://postgres:postgres@postgres:5432/ru_liquidity_sentinel?sslmode=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=true
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DEFAULT_TTL_SECONDS=300
REDIS_DASHBOARD_TTL_SECONDS=90
REDIS_LSI_TTL_SECONDS=180
REDIS_MODULES_TTL_SECONDS=180
REDIS_MODULE_SIGNALS_TTL_SECONDS=600
REDIS_LSI_HISTORY_TTL_SECONDS=300
REDIS_JOB_TTL_SECONDS=900
REDIS_LOCK_TTL_SECONDS=900
REDIS_BACKTEST_TTL_SECONDS=1800

BACKEND_PORT=8080
ML_GRPC_PORT=50051
FRONTEND_PORT=3000

LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_WINDOW=4096
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=5

# ML history bootstrap
RLS_BOOTSTRAP_HISTORY_ON_STARTUP=true
RLS_BOOTSTRAP_HISTORY_FROM=2021-01-01
RLS_BOOTSTRAP_RUN_HISTORICAL_PARSERS=true
RLS_BOOTSTRAP_RUN_PROCESSING_SCRIPTS=true
